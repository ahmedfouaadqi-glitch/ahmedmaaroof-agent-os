# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
AGENT_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./data/agent_os.sqlite3
VAULT_PATH=./Vault

# Model Gateway (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Ahmed Maaroof Agent OS

# Automation worker — disabled by default; enabling it may call the configured model provider
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_POLL_SECONDS=5
AUTOMATION_TIMEOUT_SECONDS=120

# Optional integrations — configure only after deploying trusted connectors
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
CALENDAR_PROVIDER_URL=
CALENDAR_PROVIDER_TOKEN=
IMAGE_PROVIDER_API_KEY=

# Optional local voice sidecars
WHISPER_SERVICE_URL=http://127.0.0.1:8765
KOKORO_SERVICE_URL=http://127.0.0.1:8880
