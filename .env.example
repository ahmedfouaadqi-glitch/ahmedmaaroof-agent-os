# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
AGENT_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./data/agent_os.sqlite3
VAULT_PATH=./Vault

# Model Gateway (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Ahmed Maaroof Agent OS

# Automation worker — disabled by default; enabling it may call the configured model provider
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_POLL_SECONDS=5
AUTOMATION_TIMEOUT_SECONDS=120

# Optional integrations — configure only after deploying trusted connectors
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
CALENDAR_PROVIDER_URL=
CALENDAR_PROVIDER_TOKEN=
IMAGE_PROVIDER_API_KEY=
DESIGNER_PROVIDER_ENDPOINT=
DESIGNER_PROVIDER_MODEL=
DESIGNER_COST_PER_IMAGE_USD=0
DESIGNER_MAX_COST_USD=0

# Optional local voice sidecars
WHISPER_SERVICE_URL=http://127.0.0.1:8765
KOKORO_SERVICE_URL=http://127.0.0.1:8880

# OAuth token encryption — generate a Fernet key and keep it server-side only
OAUTH_TOKEN_ENCRYPTION_KEY=

# Email OAuth 2.0 provider (authorization-code + PKCE)
EMAIL_OAUTH_AUTHORIZATION_URL=
EMAIL_OAUTH_TOKEN_URL=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=
EMAIL_OAUTH_SCOPES=

# Calendar OAuth 2.0 provider (authorization-code + PKCE)
CALENDAR_OAUTH_AUTHORIZATION_URL=
CALENDAR_OAUTH_TOKEN_URL=
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=
CALENDAR_OAUTH_SCOPES=

# API abuse and request-size protection
MAX_BODY_BYTES=20971520
RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
